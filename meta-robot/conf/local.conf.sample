# ─────────────────────────────────────────────────────────────────────────────
#  local.conf — Proyecto I: Robot Aspiradora Autonomo
#  CE-1113 Sistemas Empotrados — Raspberry Pi 4 Model B
#
#  Copie el bloque de este archivo al final de build/conf/local.conf, que Yocto
#  genera la primera vez que se ejecuta `source oe-init-build-env`.
#  build/conf/local.conf NO se versiona: depende de rutas locales de cada host.
# ─────────────────────────────────────────────────────────────────────────────

CONF_VERSION = "2"

# ── Maquina y distribucion ───────────────────────────────────────────────────
# raspberrypi4-64 selecciona el BSP aarch64 de meta-raspberrypi. Se usa la
# variante de 64 bits porque el kernel 6.6 de la RPi4 la trae por defecto y
# permite usar los paquetes kernel-module-* precompilados sin recompilar.
MACHINE = "raspberrypi4-64"
DISTRO  = "poky"

# ── Gestor de arranque: systemd ──────────────────────────────────────────────
# El enunciado exige una unidad systemd propia con arranque automatico, asi que
# se reemplaza sysvinit (init manager por defecto de poky) por systemd.
# usrmerge unifica /bin y /usr/bin, requisito de systemd en Yocto.
DISTRO_FEATURES:append = " systemd usrmerge wifi"
DISTRO_FEATURES_BACKFILL_CONSIDERED += "sysvinit"
VIRTUAL-RUNTIME_init_manager = "systemd"
VIRTUAL-RUNTIME_initscripts  = "systemd-compat-units"

# ── Capacidades de la maquina ────────────────────────────────────────────────
# wifi habilita el firmware y los drivers del chip Broadcom integrado.
# alsa habilita el subsistema de audio del kernel.
MACHINE_FEATURES:append = " wifi alsa"

# ── Licencias ────────────────────────────────────────────────────────────────
# El firmware WiFi de la RPi4 esta marcado con este flag; sin aceptarlo
# bitbake excluye linux-firmware-rpidistro-bcm43455 de la imagen.
LICENSE_FLAGS_ACCEPTED = "synaptics-killswitch"

# ── WiFi, audio y video ──────────────────────────────────────────────────────
ENABLE_WIFI  = "1"
ENABLE_AUDIO = "1"

# Consola serie: imprescindible para depurar sin HDMI.
# El parser de bitbake NO acepta comentarios al final de una linea de
# asignacion, solo en lineas propias. Un '#' despues de un valor produce
# "ParseError: unparsed line".
ENABLE_UART  = "1"

# El robot no lleva pantalla: se desactiva el driver grafico VC4 para no
# arrastrar Mesa ni el stack de DRM a la imagen (ahorro importante de rootfs).
DISABLE_VC4GRAPHICS = "1"

# ── Modulos de kernel a cargar en el arranque ────────────────────────────────
# brcmfmac + brcmutil: WiFi. snd-bcm2835: salida de audio por el jack 3.5 mm.
KERNEL_MODULE_AUTOLOAD += "cfg80211 brcmfmac brcmfmac-wcc brcmutil rfkill snd-bcm2835"

MACHINE_EXTRA_RRECOMMENDS += " \
    linux-firmware-rpidistro-bcm43455 \
    linux-firmware-rpidistro-bcm43456 \
"

# ── config.txt del bootloader ────────────────────────────────────────────────
# audio_pwm_mode=2 activa el modo PWM de mayor calidad del jack analogico.
RPI_EXTRA_CONFIG:append = "\ndtparam=audio=on\naudio_pwm_mode=2\n"

# ── Desarrollo ───────────────────────────────────────────────────────────────
# debug-tweaks deja root sin contrasena para poder entrar por SSH durante el
# desarrollo. QUITAR de la imagen de entrega final.
EXTRA_IMAGE_FEATURES += "debug-tweaks"

# rm_work borra tmp/work/ de cada receta al terminarla: sin esto el build
# supera facilmente los 100 GB. Se excluye robot-image para conservar el
# rootfs desempaquetado y poder inspeccionarlo.
INHERIT += "rm_work"
RM_WORK_EXCLUDE += "robot-image librobot robot-server"

# ── Paralelismo (ajustar al host de cada quien) ──────────────────────────────
# Regla practica: un hilo por nucleo, pero limitado por la RAM. Cada tarea de
# compilacion pesada (gcc-cross, binutils, glibc, el kernel) puede pedir 2 GB.
#
#   >= 16 GB RAM  ->  BB_NUMBER_THREADS = un hilo por nucleo
#      8-16 GB    ->  la mitad de los nucleos
#      <= 8 GB    ->  2 hilos, y activar la regulacion por presion de abajo
#
# BB_NUMBER_THREADS = "8"
# PARALLEL_MAKE     = "-j 8"

# ── Regulacion por presion de recursos ───────────────────────────────────────
# Requiere PSI en el kernel; verificar con: ls /proc/pressure/
#
# bitbake deja de lanzar tareas nuevas mientras la presion supere el umbral,
# expresado en microsegundos de bloqueo por segundo. Limitar los hilos acota el
# caso promedio; esto acota el pico, que es lo que realmente tumba la maquina.
#
# En el host de desarrollo del grupo (4 nucleos, 7 GB RAM) un build con
# BB_NUMBER_THREADS = "3" agoto los 4 GB de swap y colgo la maquina al 67% del
# progreso, con tres tareas pesadas coincidiendo: el do_fetch del kernel de la
# RPi, el do_compile de binutils y un do_configure. Con 2 hilos mas estos dos
# limites el build completa.
#
# Descomentar en hosts con 8 GB de RAM o menos:
# BB_PRESSURE_MAX_MEMORY = "5000"
# BB_PRESSURE_MAX_IO     = "15000"
